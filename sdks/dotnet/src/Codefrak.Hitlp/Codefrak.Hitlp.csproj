<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Codefrak.Hitlp</PackageId>
    <RootNamespace>Codefrak.Hitlp</RootNamespace>
    <Version>0.1.0</Version>
    <Description>.NET SDK for HITLP, the human-in-the-loop-protocol: v1.0 (draft), client side.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored from spec/schemas by sdks/scripts/sync-schemas.mjs; never edit by hand. -->
    <EmbeddedResource Include="Schemas/*.json" LogicalName="Codefrak.Hitlp.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
