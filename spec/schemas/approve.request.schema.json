{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codefrak-oss/hitlp/spec/schemas/approve.request.schema.json",
  "title": "HITLP human.approve arguments",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": ["action", "payload"],
  "properties": {
    "action": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "payloadDigest": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "maxUses": { "type": "integer", "minimum": 1 },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    },
    "teach": {
      "description": "Follow-ups the requester offers after the decision (spec 5.5). Carried, never interpreted; the id once is reserved.",
      "type": "object",
      "required": ["options"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "after"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "const": "once" } },
              "label": { "type": "string", "minLength": 1 },
              "after": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["approve", "reject"] } },
              "editable": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "default": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
