{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codefrak-oss/hitlp/spec/schemas/surface/decide.request.schema.json",
  "title": "HITLP surface API decision (spec 7.8)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "reason": {
          "type": "string"
        },
        "payloadDigest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": true,
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
