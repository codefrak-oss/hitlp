{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codefrak-oss/hitlp/spec/schemas/surface/decide.request.schema.json",
  "title": "HITLP surface API decision (spec 7.8)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "reason": {
          "type": "string"
        },
        "payloadDigest": {
          "type": "string"
        },
        "teach": {
          "type": "object",
          "required": [
            "option"
          ],
          "description": "The human's teach choice (spec 5.5, 6): an offered option's id and, when it is editable, the edited text.",
          "properties": {
            "option": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": true,
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  ]
}
